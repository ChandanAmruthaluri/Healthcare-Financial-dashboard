{"cells":[{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import random\n","from datetime import datetime, timedelta\n","\n","# --- CONFIGURATION ---\n","NUM_INVOICES = 50000\n","START_DATE = datetime(2023, 1, 1)\n","\n","# --- 1. GENERATE DIM_DEPARTMENT ---\n","departments = [\n","    {'id': 101, 'name': 'Cardiology', 'annual_budget': 12000000},\n","    {'id': 102, 'name': 'Neurology', 'annual_budget': 10000000},\n","    {'id': 103, 'name': 'Orthopedics', 'annual_budget': 8500000},\n","    {'id': 104, 'name': 'Radiology', 'annual_budget': 5000000},\n","    {'id': 105, 'name': 'Pediatrics', 'annual_budget': 6000000},\n","    {'id': 106, 'name': 'Emergency', 'annual_budget': 15000000}\n","]\n","df_dept = pd.DataFrame(departments)\n","df_dept.to_csv('dim_department.csv', index=False)\n","print(\"✅ dim_department.csv created.\")\n","\n","# --- 2. GENERATE FACT_INVOICES ---\n","data = []\n","print(\"⏳ Generating 50k invoices... this might take 10 seconds.\")\n","\n","payer_types = ['Insurance', 'Self-Pay', 'Medicare', 'Private']\n","statuses = ['Paid', 'Paid', 'Paid', 'Pending', 'Overdue'] # Weighted so most are paid\n","\n","for i in range(1, NUM_INVOICES + 1):\n","    # Dimensions\n","    dept = random.choice(departments)\n","    dept_id = dept['id']\n","    patient_id = random.randint(1000, 99999)\n","    payer = random.choice(payer_types)\n","\n","    # Dates\n","    # Random date in the last 2 years\n","    invoice_date = START_DATE + timedelta(days=random.randint(0, 700))\n","    due_date = invoice_date + timedelta(days=30) # Net 30 terms\n","\n","    # Financials\n","    # Vary invoice amount based on department (Surgery is expensive!)\n","    if dept['name'] in ['Cardiology', 'Neurology']:\n","        amount = round(random.uniform(5000, 50000), 2)\n","    elif dept['name'] == 'Emergency':\n","        amount = round(random.uniform(500, 10000), 2)\n","    else:\n","        amount = round(random.uniform(200, 5000), 2)\n","\n","    # Status Logic\n","    status = random.choice(statuses)\n","\n","    payment_date = None\n","    paid_amount = 0\n","\n","    if status == 'Paid':\n","        # Paid within 10-60 days of invoice\n","        payment_date = invoice_date + timedelta(days=random.randint(5, 60))\n","        paid_amount = amount # Full payment\n","    elif status == 'Overdue':\n","        paid_amount = 0\n","    elif status == 'Pending':\n","        paid_amount = 0\n","\n","    # formatting dates for CSV\n","    inv_str = invoice_date.strftime('%Y-%m-%d')\n","    due_str = due_date.strftime('%Y-%m-%d')\n","    pay_str = payment_date.strftime('%Y-%m-%d') if payment_date else None\n","\n","    data.append([i, patient_id, dept_id, inv_str, due_str, amount, paid_amount, pay_str, payer, status])\n","\n","# Create DataFrame\n","cols = ['invoice_id', 'patient_id', 'department_id', 'invoice_date', 'due_date', 'invoice_amount', 'paid_amount', 'payment_date', 'payer_type', 'status']\n","df_fact = pd.DataFrame(data, columns=cols)\n","\n","df_fact.to_csv('fact_invoices.csv', index=False)\n","print(f\"✅ fact_invoices.csv created with {NUM_INVOICES} rows.\")"],"metadata":{"id":"NEksIsGjllnX","executionInfo":{"status":"ok","timestamp":1766902378613,"user_tz":-330,"elapsed":1745,"user":{"displayName":"","userId":""}},"outputId":"24b5768b-83a5-45c2-e0cf-c27e7587ea2d","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ dim_department.csv created.\n","⏳ Generating 50k invoices... this might take 10 seconds.\n","✅ fact_invoices.csv created with 50000 rows.\n"]}]}],"metadata":{"colab":{"provenance":[{"file_id":"/v2/external/notebooks/intro.ipynb","timestamp":1766902613096}]},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}